GEMINI_API_KEY= 
GEMINI_MODEL=gemini-3.8-flash

# stub = sample data, no network. live = Shopee data providers (links) + Gemini Vision (screenshots).
NEEDL_SOURCE=stub
# stub = sample checks. real = Gemini analysis of available listing and review evidence.
NEEDL_ANALYZER=stub

# Firestore. Local development and tests use the emulator (scripts/firestore_emulator.sh).
# Without FIRESTORE_EMULATOR_HOST the service uses Application Default Credentials
# (gcloud auth application-default login) and the real project.
GOOGLE_CLOUD_PROJECT=needl-local
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# FIRESTORE_DATABASE=(default)

# Shopee providers, tried in order. One without credentials is skipped.
SHOPEE_PROVIDERS=apify,rapidapi
SHOPEE_MAX_REVIEWS=100

# Apify: https://console.apify.com/settings/integrations
APIFY_TOKEN=
# APIFY_DETAIL_ACTOR=zen-studio~shopee-product-detail-scraper
# APIFY_REVIEWS_ACTOR=zen-studio~shopee-product-reviews-scraper
# APIFY_MAX_CHARGE_USD=0.50

# RapidAPI: copy the endpoint from the API's Code Snippets tab.
# Placeholders: {shop_id} {item_id} {url} {limit}
RAPIDAPI_KEY=
# RAPIDAPI_SHOPEE_DETAIL_URL=https://<host>.p.rapidapi.com/<path>?shop_id={shop_id}&item_id={item_id}
# RAPIDAPI_SHOPEE_REVIEWS_URL=https://<host>.p.rapidapi.com/<path>?shop_id={shop_id}&item_id={item_id}&limit={limit}

CORS_ORIGINS=http://localhost:5173
# UPLOAD_DIR=data/uploads
# All screenshots of one request together, 1-30 MiB (Cloud Run caps requests at 32 MiB).
# MAX_UPLOAD_TOTAL_MB=30
# /scrape, /analyze and /analyze-image (need Playwright + Chromium).
# ENABLE_LEGACY_ROUTES=true
